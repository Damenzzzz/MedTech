# Copy to docker/.env (./docker/up.sh does it for you). Never commit docker/.env.

# === Provider keys ===
# Alem (llm.alem.ai): chat model alemllm — web assistant and basic-rag query rewriting
ALEM_API_KEY=
# Vertex AI express-mode key: final answers (gemini-3.6-flash), embeddings
# (gemini-embedding-001) and rerank for both RAGs, all via gemini-proxy
GEMINI_API_KEY=
# Optional: OpenAI key for speech-to-text in web (then set STT_PROVIDER=openai)
OPENAI_API_KEY=

# Session cookie signing — up.sh generates one if empty
SESSION_SECRET=

# Filled by up.sh from `supabase status` (local Supabase)
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides
# WEB_RAG_SERVICE_URL=http://rag-service:8080
# FINAL_LLM_MODEL=gemini-3.6-flash
# GEMINI_THINKING_LEVEL=low          # minimal|low|medium|high
# STT_PROVIDER=openai                # needs OPENAI_API_KEY
# Use OpenAI directly instead of Gemini:
# FINAL_LLM_BASE_URL=https://api.openai.com/v1
# FINAL_LLM_API_KEY=sk-...
# FINAL_LLM_MODEL=gpt-5.5
# BASIC_RAG_DIR=/path/to/RAG_medtech
#
# Use the original Alem text-1024 indexes (same as production) instead of Gemini embeddings —
# needs an Alem key with access to text-1024 and reranker:
# EMBED_BASE_URL=https://llm.alem.ai/v1
# EMBED_API_KEY=sk-...
# RERANK_BASE_URL=https://llm.alem.ai/v1/rerank
# RERANK_API_KEY=sk-...
# BASIC_RAG_EMBED_MODEL=text-1024
# BASIC_RAG_CHROMA_DIR=/app/basic_rag/chroma_db
# RAG_SERVICE_EMBED_MODEL=text-1024
# RAG_SERVICE_INDEX_DIR=data/indexes
