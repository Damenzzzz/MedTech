# Copy to docker/.env (./docker/up.sh does it for you). Never commit docker/.env.

# === Provider keys ===
# Alem (llm.alem.ai): chat model alemllm, embeddings text-1024, reranker — used by web and both RAGs
ALEM_API_KEY=
# OpenAI: final/LLM model in both RAGs (gpt-5.5) and speech-to-text in web
OPENAI_API_KEY=

# Session cookie signing — up.sh generates one if empty
SESSION_SECRET=

# Filled by up.sh from `supabase status` (local Supabase)
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides
# WEB_RAG_SERVICE_URL=http://rag-service:8080
# OPENAI_FINAL_MODEL=gpt-5.5
# STT_PROVIDER=mock
# BASIC_RAG_DIR=/path/to/RAG_medtech
